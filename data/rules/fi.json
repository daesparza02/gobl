{
  "id": "GOBL-FI",
  "package": "fi",
  "subsets": [
    {
      "id": "GOBL-FI-BILL-INVOICE",
      "object": "bill.Invoice",
      "subsets": [
        {
          "guard": "context: regime in [FI]",
          "subsets": [
            {
              "field": "supplier",
              "assert": [
                {
                  "id": "GOBL-FI-BILL-INVOICE-01",
                  "desc": "invoice FI supplier must have either tax ID code or identity with 'Y-TUNNUS' type",
                  "tests": "has tax ID code or identity with 'Y-TUNNUS' type"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-FI-ORG-IDENTITY",
      "object": "org.Identity",
      "subsets": [
        {
          "guard": "context: regime in [FI]",
          "subsets": [
            {
              "guard": "type in [Y-TUNNUS]",
              "subsets": [
                {
                  "field": "code",
                  "assert": [
                    {
                      "id": "GOBL-FI-ORG-IDENTITY-01",
                      "desc": "identity code for type Y-TUNNUS must be valid",
                      "tests": "valid"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "GOBL-FI-TAX-IDENTITY",
      "object": "tax.Identity",
      "subsets": [
        {
          "guard": "code in [FI]",
          "subsets": [
            {
              "field": "code",
              "subsets": [
                {
                  "guard": "present",
                  "assert": [
                    {
                      "id": "GOBL-FI-TAX-IDENTITY-01",
                      "desc": "invalid Finnish VAT identity code",
                      "tests": "valid"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
